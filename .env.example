# Optional. Local mode uses existing CLI sign-ins; no keys are required.
# CLAUDE_BIN=claude
# CODEX_CLI_PATH=/absolute/path/to/codex
MODEL_TIMEOUT_SECONDS=180

# Force simulated players for every request, including clients requesting Local/API.
# ARENA_TEST_MODE=1

# Optional API mode only. Never commit your populated .env file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional stable secret to preserve browser sessions across server restarts.
# FLASK_SECRET_KEY=
